# 复制为 credentials.local.yaml 后填写真实值，或在平台凭据界面创建同名 Secret。
# 本示例不包含在 ragflow.yaml 中；提交到与应用相同的 namespace。
# 命令：kubectl -n 实际命名空间 apply -f k8s/credentials.local.yaml
apiVersion: v1
kind: Secret
metadata:
  name: ragflow-v0240-credentials
type: Opaque
# 填写原始字符串，不需要手工 Base64；值仍需遵循 YAML 引号和转义规则。
stringData:
  MYSQL_PASSWORD: "REPLACE_ME_MYSQL_PASSWORD"
  # 平台确认 Redis 无密码时才填空字符串。
  REDIS_PASSWORD: "REPLACE_ME_REDIS_PASSWORD"
  # ES 无认证时此项留空，并将 ragflow.yaml 的 ES_USER 同时留空。
  ES_PASSWORD: "REPLACE_ME_ES_PASSWORD"
  OBJECT_STORAGE_ACCESS_KEY: "REPLACE_ME_ACCESS_KEY"
  OBJECT_STORAGE_SECRET_KEY: "REPLACE_ME_SECRET_KEY"
