# Used by both the init container and the application. Do not put credentials here.
API_PROXY_SCHEME=python
DB_TYPE=mysql
DOC_ENGINE=elasticsearch
# MINIO or AWS_S3
STORAGE_IMPL=MINIO
TZ=Asia/Shanghai
# Keep enabled for initial account creation; change to 0 afterwards if required.
REGISTER_ENABLED=1
USE_DOCLING=false
# Initial validation: limit concurrent parsing and embedding work.
MAX_CONCURRENT_TASKS=1
MAX_CONCURRENT_CHUNK_BUILDERS=1
