# 应用运行参数：初始化容器和主容器共同使用，不要在这里填写密码或密钥。
# 固定启动 Python 后端，对应镜像内的 Python Nginx 路由配置。
API_PROXY_SCHEME=python
# 元数据数据库类型；当前部署模板仅配置 MySQL。
DB_TYPE=mysql
# 文档索引和检索引擎；当前部署模板仅配置 Elasticsearch。
DOC_ENGINE=elasticsearch
# 对象存储类型：MinIO 填 MINIO，其他兼容 S3 的服务填 AWS_S3，不能填 S3。
STORAGE_IMPL=MINIO
# 容器时区。
TZ=Asia/Shanghai
# 是否允许注册：1 为开启，0 为关闭。首次创建账号后可按平台要求关闭。
REGISTER_ENABLED=1
# 是否启用可选的 Docling 解析器；false 避免入口在启动时安装该额外依赖。
USE_DOCLING=false
# 单个工作进程的任务并发上限；首次联调用 1，后续根据实测资源情况调整。
MAX_CONCURRENT_TASKS=1
# 分块构建和嵌入操作的并发上限，首次联调用 1。
MAX_CONCURRENT_CHUNK_BUILDERS=1
