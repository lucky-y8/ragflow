# 外部中间件连接参数：仅注入 render-config 初始化容器，由脚本转换成应用配置。
# 部署前替换所有 REPLACE_ME 占位符；不要在本文件填写密码，也不要给值额外加引号。
# 密码和访问密钥填写在同 namespace 的 ragflow-credentials Secret 中。

# MySQL 主机名或 IPv4 地址，不含 http://、端口或数据库名称。
MYSQL_HOST=REPLACE_ME_MYSQL_HOST
# 平台提供的 MySQL 端口，默认 3306，可按实际情况修改。
MYSQL_PORT=3306
# 平台预先创建的数据库名称。
MYSQL_DBNAME=REPLACE_ME_DATABASE
# 具备该数据库建表、变更表和读写权限的账号。
MYSQL_USER=REPLACE_ME_MYSQL_USER
# 单个进程的连接池上限；API 和各工作进程分别维护连接池，总数可能超过此值。
MYSQL_MAX_CONNECTIONS=32

# Redis 单地址连接：填写主机名或 IPv4，不含协议和端口。
# 当前模板不支持 Redis TLS、Sentinel 哨兵和 Redis Cluster 集群。
REDIS_HOST=REPLACE_ME_REDIS_HOST
# Redis 实际服务端口。
REDIS_PORT=6379
# 应用专用逻辑数据库编号；平台只允许 DB 0 时改成 0。
REDIS_DB=1
# Redis ACL 用户名；平台未配置用户名时留空。
REDIS_USERNAME=

# Elasticsearch 完整地址，包含 http:// 或 https:// 和端口；多个节点用逗号分隔。
ES_HOSTS=http://REPLACE_ME_ES_HOST:9200
# Elasticsearch 用户名；无认证时，此项和 Secret 中 ES_PASSWORD 必须同时留空。
ES_USER=REPLACE_ME_ES_USER
# HTTPS 连接是否校验服务端证书，默认 true；内部 CA 的处理见部署说明。
ES_VERIFY_CERTS=true

# 对象存储完整服务地址，包含协议和实际端口，不要在地址后追加桶名。
# https:// 会启用 TLS；MinIO 分支默认校验证书。
OBJECT_STORAGE_ENDPOINT=http://REPLACE_ME_OBJECT_STORAGE_HOST:9000
# 平台预先创建的桶名称，应用凭据需要拥有该桶的相应访问权限。
OBJECT_STORAGE_BUCKET=REPLACE_ME_BUCKET
# 对象键的公共前缀，用于区分应用数据；此模板要求非空。
OBJECT_STORAGE_PREFIX=ragflow
# 存储服务所在区域，按平台要求填写；当前值仅为常见示例。
OBJECT_STORAGE_REGION=us-east-1
# 仅 STORAGE_IMPL=AWS_S3 时使用：path 为路径寻址，virtual 为虚拟主机寻址。
S3_ADDRESSING_STYLE=path
