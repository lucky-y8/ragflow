# Used ONLY by render-config. These are template inputs, not upstream variable names.
# Replace every REPLACE_ME value before deployment. Do not quote values in this file.
MYSQL_HOST=REPLACE_ME_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DBNAME=REPLACE_ME_DATABASE
MYSQL_USER=REPLACE_ME_MYSQL_USER
# Per process; API and each worker maintain their own pool.
MYSQL_MAX_CONNECTIONS=32

# Single DNS name / IPv4 endpoint, without TLS, Sentinel or Redis Cluster.
REDIS_HOST=REPLACE_ME_REDIS_HOST
REDIS_PORT=6379
REDIS_DB=1
REDIS_USERNAME=

# Full URL(s), comma-separated. ES_USER and ES_PASSWORD must both be blank for no auth.
ES_HOSTS=http://REPLACE_ME_ES_HOST:9200
ES_USER=REPLACE_ME_ES_USER
ES_VERIFY_CERTS=true

# http:// or https://, with the platform's actual port. Pre-create the bucket.
OBJECT_STORAGE_ENDPOINT=http://REPLACE_ME_OBJECT_STORAGE_HOST:9000
OBJECT_STORAGE_BUCKET=REPLACE_ME_BUCKET
OBJECT_STORAGE_PREFIX=ragflow
OBJECT_STORAGE_REGION=us-east-1
# Only used when STORAGE_IMPL=AWS_S3.
S3_ADDRESSING_STYLE=path
