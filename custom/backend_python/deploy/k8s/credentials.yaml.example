# Copy to credentials.local.yaml, fill it in, and apply in the SAME namespace.
# Or have the platform create this Secret through its credential UI.
# This example is intentionally excluded from kustomization.yaml and the rendered bundle.
apiVersion: v1
kind: Secret
metadata:
  name: ragflow-credentials
type: Opaque
stringData:
  MYSQL_PASSWORD: "REPLACE_ME_MYSQL_PASSWORD"
  # Use an empty string only when the platform confirms passwordless Redis.
  REDIS_PASSWORD: "REPLACE_ME_REDIS_PASSWORD"
  # Use an empty string together with ES_USER= when Elasticsearch has no authentication.
  ES_PASSWORD: "REPLACE_ME_ES_PASSWORD"
  OBJECT_STORAGE_ACCESS_KEY: "REPLACE_ME_ACCESS_KEY"
  OBJECT_STORAGE_SECRET_KEY: "REPLACE_ME_SECRET_KEY"
