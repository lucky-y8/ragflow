# 密码和密钥示例：复制为 credentials.local.yaml 后填写真实值。
# 使用 kubectl -n 实际命名空间 apply -f credentials.local.yaml 提交，
# 或由平台通过凭据管理界面创建同名 Secret；必须与应用处于同一 namespace。
# 此示例未加入 kustomization.yaml，也不会包含在合并部署 YAML 中。
# credentials.local.yaml 已被本目录的 .gitignore 排除，不要提交真实密钥。
apiVersion: v1
kind: Secret
metadata:
  # Deployment 的初始化容器通过此名称读取密码，修改时需要同步修改引用。
  name: ragflow-credentials
type: Opaque
# stringData 接收原始字符串，由 Kubernetes 转换成 Secret 数据，无需手工 Base64 编码。
# 密码包含引号或反斜杠时，要遵循 YAML 转义规则；也可直接使用平台凭据界面填写。
stringData:
  # MySQL 账号密码，对应 connections.env 中的 MYSQL_USER。
  MYSQL_PASSWORD: "REPLACE_ME_MYSQL_PASSWORD"
  # 仅在平台确认 Redis 无密码时填空字符串 ""。
  REDIS_PASSWORD: "REPLACE_ME_REDIS_PASSWORD"
  # Elasticsearch 无认证时填空字符串 ""，并同时将 ES_USER 留空。
  ES_PASSWORD: "REPLACE_ME_ES_PASSWORD"
  # 对象存储访问标识（Access Key），MINIO 和 AWS_S3 两种模式共用。
  OBJECT_STORAGE_ACCESS_KEY: "REPLACE_ME_ACCESS_KEY"
  # 与访问标识配套的访问密钥（Secret Key）。
  OBJECT_STORAGE_SECRET_KEY: "REPLACE_ME_SECRET_KEY"
